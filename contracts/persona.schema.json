{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ci.local/contracts/persona.schema.json",
  "title": "Smart CI Persona",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "selectable", "isDefault", "activePackageId", "display"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "status": { "enum": ["draft", "active", "deprecated", "retired"] },
    "selectable": { "type": "boolean" },
    "isDefault": { "type": "boolean" },
    "order": { "type": "integer", "minimum": 0 },
    "activePackageId": { "type": "string", "minLength": 1 },
    "display": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": { "$ref": "#/$defs/display" }
    }
  },
  "$defs": {
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}