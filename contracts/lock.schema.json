{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ci.local/contracts/lock.schema.json",
  "title": "Smart CI Resource Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "targetType", "targetId", "operations", "reason", "transferable"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "targetType": { "enum": ["persona", "content-package"] },
    "targetId": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["delete", "retire", "deprecate", "unassign", "replace", "edit"] }
    },
    "reason": { "type": "string", "minLength": 1 },
    "transferable": { "type": "boolean" }
  }
}