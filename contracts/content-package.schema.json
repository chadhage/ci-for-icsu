{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ci.local/contracts/content-package.schema.json",
  "title": "Smart CI Content Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "locales", "fallbackLocale", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "fallbackLocale": { "type": "string", "minLength": 2 },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    }
  }
}